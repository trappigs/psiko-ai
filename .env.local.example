# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — OpenAI (varsayılan)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# LLM — alternatif sağlayıcılar (Gemini, Groq, Anthropic-OpenAI-compat, vb.)
# Doluyu ana OPENAI_API_KEY/OPENAI_BASE_URL'in yerine geçer.
# Örn. Gemini için:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<gemini api key>
#   OPENAI_MODEL=gemini-3-flash
LLM_BASE_URL=
LLM_API_KEY=

# Test/yerel için sahte yanıt modu
MOCK_OPENAI=false

# Limits
DAILY_SESSION_LIMIT=5
DAILY_TOKEN_LIMIT=100000
SESSION_DURATION_MINUTES=45
